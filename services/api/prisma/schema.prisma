generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["voting"]
}

// Application accounts are distinct from election-specific chain identities.
model AppUser {
  id           String   @id @default(uuid()) @db.Uuid
  username     String
  usernameKey  String   @unique
  passwordHash String
  fullName     String
  email        String?
  phone        String?
  role         String   @default("USER")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  sessions     AppSession[]
  auditEntries AdminActivity[] @relation("ActivityActor")
  maciEligibilities MaciEligibility[]
  maciRegistrations MaciRegistration[]
  participationRequests MaciParticipationRequest[] @relation("ParticipationVoter")
  reviewedParticipationRequests MaciParticipationRequest[] @relation("ParticipationReviewer")
  deploymentJobs MaciDeploymentJob[]

  @@schema("voting")
}

model AdminActivity {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String
  targetId  String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  actor     AppUser  @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@schema("voting")
}

model AppSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@schema("voting")
}

// MACI metadata and identity-side issuance records. Encrypted ballot messages never belong here.
model MaciElection {
  id                  String @id @default(uuid()) @db.Uuid
  chainId             String
  deploymentInstanceId String @default("legacy")
  maciAddress         String
  registrationAddress String
  pollAddress         String
  pollId              String
  deploymentBlock     String
  title               String
  candidates          Json
  coordinatorKeyX     String
  coordinatorKeyY     String
  startTimestamp      String
  endTimestamp        String
  voteOptions         Int
  protocolVersion     String @default("maci-v3.0.0-full-v1")
  status              String @default("REGISTRATION")
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)
  eligibilities       MaciEligibility[]
  registrations       MaciRegistration[]
  auditRecord          MaciAuditRecord?
  coordinatorRuns      MaciCoordinatorRun[]
  proofSubmissions     MaciProofSubmission[]
  participationRequests MaciParticipationRequest[]
  deploymentJob MaciDeploymentJob?
  proofJob MaciProofJob?

  @@unique([chainId, maciAddress, deploymentInstanceId])
  @@unique([chainId, pollAddress, deploymentInstanceId])
  @@schema("voting")
}

model MaciEligibility {
  id         String @id @default(uuid()) @db.Uuid
  electionId String @db.Uuid
  userId     String @db.Uuid
  status     String @default("ELIGIBLE")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  election   MaciElection @relation(fields: [electionId], references: [id], onDelete: Restrict)
  user       AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([electionId, userId])
  @@schema("voting")
}

// Account-side request history; never contains ballot choices or MACI private keys.
model MaciParticipationRequest {
  id String @id @default(uuid()) @db.Uuid
  electionId String @db.Uuid
  userId String @db.Uuid
  status String @default("PENDING")
  requestedAt DateTime @default(now()) @db.Timestamptz(6)
  reviewedAt DateTime? @db.Timestamptz(6)
  reviewedById String? @db.Uuid
  election MaciElection @relation(fields: [electionId], references: [id], onDelete: Restrict)
  user AppUser @relation("ParticipationVoter", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy AppUser? @relation("ParticipationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([electionId, userId])
  @@index([electionId, status, requestedAt])
  @@schema("voting")
}

// A claimed job is never automatically rerun after a crash: a transaction may have been submitted.
model MaciDeploymentJob {
  id String @id @default(uuid()) @db.Uuid
  requestedById String @db.Uuid
  idempotencyKey String
  requestHash String
  requestedConfig Json
  status String @default("CREATING")
  stage String @default("QUEUED")
  genesisHash String
  deployment Json?
  diagnosticCode String?
  electionId String? @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  requestedBy AppUser @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  election MaciElection? @relation(fields: [electionId], references: [id], onDelete: Restrict)

  @@unique([requestedById, idempotencyKey])
  @@index([status, createdAt])
  @@schema("voting")
}

model MaciRegistration {
  id              String @id @default(uuid()) @db.Uuid
  electionId      String @db.Uuid
  userId          String @db.Uuid
  publicKeyX      String
  publicKeyY      String
  ticket          String @unique
  deadline        String
  issuerSignature String
  status          String @default("ISSUED")
  transactionHash String?
  rawTransaction  String?
  calldataHash    String?
  nonce           Int?
  blockNumber     BigInt?
  blockHash       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  election        MaciElection @relation(fields: [electionId], references: [id], onDelete: Restrict)
  user            AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([electionId, userId])
  @@unique([electionId, publicKeyX, publicKeyY])
  @@index([electionId, status])
  @@schema("voting")
}

// Public encrypted messages only. No user/account/session foreign key is permitted.
model MaciEncryptedSubmission {
  id                String @id @default(uuid()) @db.Uuid
  chainId           String
  deploymentInstanceId String @default("legacy")
  pollAddress       String
  messageDigest     String
  messageData       Json
  encryptionKeyX    String
  encryptionKeyY    String
  status            String @default("PREPARED")
  transactionHash   String?
  rawTransaction    String?
  calldataHash      String?
  nonce             Int?
  blockNumber       BigInt?
  blockHash         String?
  gasUsed           String?
  errorCode         String?
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@unique([deploymentInstanceId, messageDigest])
  @@index([chainId, pollAddress, deploymentInstanceId, status, createdAt], map: "MaciEncryptedSubmission_instance_status_idx")
  @@schema("voting")
}

// Anonymous poll-join proof submission. The registration issuer cannot query this by account.
model MaciPollJoinSubmission {
  id              String @id @default(uuid()) @db.Uuid
  chainId         String
  deploymentInstanceId String @default("legacy")
  pollAddress     String
  joinDigest      String
  publicKeyX      String
  publicKeyY      String
  nullifier       String
  status          String @default("PREPARED")
  transactionHash String?
  rawTransaction  String?
  calldataHash    String?
  nonce           Int?
  pollStateIndex  String?
  blockNumber     BigInt?
  blockHash       String?
  errorCode       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@unique([deploymentInstanceId, joinDigest])
  @@unique([chainId, pollAddress, deploymentInstanceId, nullifier], map: "MaciPollJoinSubmission_instance_nullifier_key")
  @@unique([chainId, pollAddress, deploymentInstanceId, publicKeyX, publicKeyY], map: "MaciPollJoinSubmission_instance_publicKey_key")
  @@index([chainId, pollAddress, deploymentInstanceId, status, createdAt], map: "MaciPollJoinSubmission_instance_status_idx")
  @@schema("voting")
}

// Deliberately published aggregate and proof evidence, without private circuit inputs.
model MaciAuditRecord {
  id            String @id @default(uuid()) @db.Uuid
  electionId    String @unique @db.Uuid
  manifestJson  String
  eventsNdjson  String
  proofsJson    String
  tallyJson     String
  configurationJson String?
  configurationHash String?
  snapshotBlock BigInt
  snapshotHash  String
  verifiedAt    DateTime @default(now()) @db.Timestamptz(6)
  election      MaciElection @relation(fields: [electionId], references: [id], onDelete: Restrict)

  @@schema("voting")
}

// Public evidence is staged here until an authenticated admin explicitly publishes it.
model MaciProofJob {
  id String @id @default(uuid()) @db.Uuid
  electionId String @unique @db.Uuid
  runId String @unique
  status String @default("QUEUED")
  stage String @default("QUEUED")
  diagnosticCode String?
  closingBlock BigInt
  closingHash String
  genesisHash String
  snapshotBlock BigInt?
  snapshotHash String?
  manifestJson String?
  eventsNdjson String?
  proofsJson String?
  tallyJson String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  election MaciElection @relation(fields: [electionId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@schema("voting")
}

// Operational metadata only; private coordinator witnesses stay outside the database.
model MaciCoordinatorRun {
  id             String @id @default(uuid()) @db.Uuid
  electionId     String @db.Uuid
  runId          String @unique
  status         String @default("STARTED")
  processingCount Int @default(0)
  tallyCount     Int @default(0)
  snapshotBlock  BigInt?
  errorCode      String?
  startedAt      DateTime @default(now()) @db.Timestamptz(6)
  completedAt    DateTime? @db.Timestamptz(6)
  election       MaciElection @relation(fields: [electionId], references: [id], onDelete: Restrict)

  @@index([electionId, startedAt])
  @@schema("voting")
}

// Public proof transaction references; full public proofs belong in MaciAuditRecord.
model MaciProofSubmission {
  id              String @id @default(uuid()) @db.Uuid
  electionId      String @db.Uuid
  kind            String
  batchIndex      Int
  transactionHash String @unique
  blockNumber     BigInt
  gasUsed         String
  status          String @default("INCLUDED")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  election        MaciElection @relation(fields: [electionId], references: [id], onDelete: Restrict)

  @@unique([electionId, kind, batchIndex])
  @@index([electionId, kind])
  @@schema("voting")
}

// Reorg-aware public scan checkpoint; no voter identity reference.
model MaciChainCheckpoint {
  id          String @id @default(uuid()) @db.Uuid
  chainId     String
  pollAddress String
  blockNumber BigInt
  blockHash   String
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([chainId, pollAddress])
  @@schema("voting")
}
