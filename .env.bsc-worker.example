# BSC Testnet MACI proof worker (chain 97).
# Copy to ignored .env.bsc-worker. Keep this process separate from the API/web.
# Copy the network and runtime DB values from the same .env.bsc-testnet project.
# Never commit or share private keys, database passwords, or RPC access tokens.

CHAIN_ID=97
RPC_URL=https://<server-bsc-testnet-rpc>
MACI_RPC_URL=https://<server-bsc-testnet-rpc>
CHAIN_CONFIRMATIONS=2
MACI_BSC_TESTNET_ENABLED=false

# Use the limited runtime role, not the migration role or Hardhat Local DB.
DATABASE_URL="postgresql://<runtime-user>.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=verify-full"
DATABASE_POOL_MODE=session
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
# Copy the same Supabase CA path as the API env; download the certificate on
# each runtime host before starting this worker.
DATABASE_CA_PATH=

# Both secrets belong only in this ignored worker file.
# The EVM prover wallet must be separate from the five API/deployer roles and
# have test BNB to publish proof and tally transactions.
MACI_PROVER_PRIVATE_KEY=0x<64-hex-independent-funded-prover-key>
# This is a MACI key, not an EVM private key. Match the API's public key.
MACI_COORDINATOR_PRIVATE_KEY=macisk.<64-hex-independent-coordinator-secret>

# Optional for a targeted research run: only create/reconcile proof jobs for
# this election UUID. Leave unset to process every eligible chain-97 election.
# MACI_PROOF_ELECTION_ID=<election-uuid>
