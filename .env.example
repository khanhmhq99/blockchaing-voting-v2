# Copy to .env locally. Never put actual credentials in this example.
# Copy connection strings from the existing Supabase project's Connect panel.
# Use a dedicated runtime role and the private voting schema.
# PostgreSQL credentials are required; the Supabase publishable key is unused.
# Supavisor Session pooler (IPv4), using the endpoint supplied by the owner.
# DATABASE_URL requires a separate runtime login with access to the voting schema.
# MIGRATION_DATABASE_URL uses the supplied postgres login for schema migrations.
# URL-encode passwords. These templates are NOT ready-to-connect credentials.
DATABASE_URL="postgresql://[RUNTIME_ROLE].igyjcwppnkysckhirfpk:[RUNTIME_PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=verify-full"
# Migration connection: Session pooler port 5432; never transaction port 6543.
MIGRATION_DATABASE_URL="postgresql://postgres.igyjcwppnkysckhirfpk:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=verify-full"
# session for a long-lived NestJS server; transaction for serverless runtime only.
DATABASE_POOL_MODE=session
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
# Optional absolute path to the Supabase CA certificate. TLS verification stays enabled.
DATABASE_CA_PATH=

# Server-side RPC URL may contain a credential; it is never returned to the browser.
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
CHAIN_ID=97
# Required: verified GaslessVoting address on CHAIN_ID; not a wallet or Supabase URL.
VOTING_CONTRACT_ADDRESS=0xaaa59087819d3e939b7a1d3394c29a3d71c4db50
# Required: blockNumber from that contract deployment transaction receipt.
# Historical chain-31337 records cannot be used for BSC Testnet (97).
DEPLOYMENT_BLOCK=136391892
CHAIN_CONFIRMATIONS=2
# Optional public HTTPS block explorer origin; omit for the local chain.
CHAIN_EXPLORER_URL=https://testnet.bscscan.com
APP_ORIGIN=http://localhost:3000
WEB_PORT=3000
API_PORT=3001
# Use 0.0.0.0 only inside the deployment environment when required.
API_HOST=127.0.0.1

# MVP 2.5 account sessions and AES-256-GCM encryption key for managed election EOAs.
# Generate 32 random bytes as 64 hex characters and keep this API-only key in a secret manager.
VOTER_KEY_ENCRYPTION_KEY=
# Demo-only seed is refused unless this is true and DATABASE_URL points to loopback PostgreSQL.
DEMO_ADMIN_SEED_ENABLED=false
DEMO_ADMIN_PASSWORD=123

# Used only by an explicitly supported deployment script; never by the web app/API.
# deploy:mvp2 supports loopback chain 31337 and explicitly configured BSC Testnet 97.
DEPLOYER_PRIVATE_KEY=

# Browser receives only the API origin. No Supabase URL/key or database credentials.
NEXT_PUBLIC_API_URL=http://localhost:3001

# MVP 2: configure a NEW GaslessVoting deployment above. Default keeps MVP 1 mode.
GASLESS_ENABLED=false
# Dedicated limited-fund server-only signer, never the contract owner.
RELAYER_PRIVATE_KEY=
RELAYER_MAX_GAS=250000
RELAYER_MAX_GAS_PRICE_WEI=10000000000
# Conservative lifetime reservation per chain/sender; not reset at process restart.
RELAYER_BUDGET_WEI=100000000000000000
RELAYER_MIN_BALANCE_WEI=1000000000000000
RELAYER_MAX_DEADLINE_SECONDS=600
RELAYER_QUEUE_LIMIT=100
RELAYER_RATE_PER_MINUTE=60
RELAYER_VOTER_ATTEMPTS=5
RELAYER_PENDING_TIMEOUT_MS=120000
