# MACI v3 synthetic research prototype. Copy to .env and supply secrets privately.
# Existing Supabase project; migration role and API runtime role are separate.
DATABASE_URL="postgresql://voting_runtime.igyjcwppnkysckhirfpk:[RUNTIME_PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=verify-full"
MIGRATION_DATABASE_URL="postgresql://postgres.igyjcwppnkysckhirfpk:[MIGRATION_PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=verify-full"
DATABASE_POOL_MODE=session
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CA_PATH=

# Use one RPC/network for API, coordinator and browser. Override all three for local Hardhat.
RPC_URL=http://127.0.0.1:8545
MACI_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CHAIN_CONFIRMATIONS=2
NEXT_PUBLIC_MACI_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_API_URL=http://localhost:3001
APP_ORIGIN=http://localhost:3000
WEB_PORT=3000
API_PORT=3001
API_HOST=127.0.0.1

# Server-only EVM signers. Use separate limited-fund keys; never expose them in web variables.
DEPLOYER_PRIVATE_KEY=
MACI_ISSUER_PRIVATE_KEY=
MACI_REGISTRATION_RELAYER_PRIVATE_KEY=
MACI_JOIN_RELAYER_PRIVATE_KEY=
MACI_RELAYER_PRIVATE_KEY=
MACI_PROVER_PRIVATE_KEY=
MACI_REGISTRATION_MAX_GAS=500000
MACI_JOIN_MAX_GAS=1000000
MACI_RELAYER_MAX_GAS=500000
MACI_RELAYER_MAX_GAS_PRICE_WEI=10000000000

# Coordinator secret is an independent MACI key in macisk.<64 hex> form.
MACI_COORDINATOR_PRIVATE_KEY=

# Synthetic admin seeding only for the inventoried thesis Supabase project.
# The seed command generates a password in ignored local research storage.
MACI_SYNTHETIC_ADMIN_ENABLED=false
