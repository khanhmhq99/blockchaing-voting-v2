{
  "name": "blockchain-voting",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/voter-web"
  ],
  "scripts": {
    "dev:api": "tsx watch services/api/src/main.ts",
    "dev:web": "node scripts/web.mjs dev",
    "chain": "hardhat node --hostname 127.0.0.1",
    "build:contracts": "node scripts/compile-contracts.mjs",
    "build:api": "tsc -p services/api/tsconfig.json",
    "build:web": "node scripts/web.mjs build",
    "build": "npm run build:contracts && npm run prisma:generate && npm run build:api && npm run build:web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @voting/web",
    "lint": "eslint services packages scripts apps/voter-web/app --ignore-pattern '**/generated/**'",
    "prisma:validate": "node scripts/prisma.mjs validate",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "db:check": "tsx scripts/check-database.ts",
    "db:migrate:status": "node scripts/prisma.mjs migrate status",
    "db:migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "seed:maci-synthetic-admin": "tsx scripts/seed-maci-synthetic-admin.ts",
    "verify:election": "node scripts/verify-election.mjs",
    "prepare:evidence-config": "node scripts/prepare-evidence-config.mjs",
    "anchor:mvp4-local": "node scripts/anchor-mvp4-local.mjs"
  },
  "dependencies": {
    "@maci-protocol/contracts": "3.0.0",
    "@maci-protocol/sdk": "3.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@openzeppelin/contracts": "5.6.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.7",
    "ethers": "6.17.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "eslint": "10.12.0",
    "hardhat": "3.19.0",
    "prisma": "7.10.0",
    "solc": "0.8.37",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "ethers": "6.17.0",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "tmp": "0.2.7"
  }
}
