# BSC Testnet (chain 97) synthetic MACI prototype.
# Copy to .env.bsc-testnet; the copy is ignored by Git. Replace every <...> value locally.
# Never commit or paste database passwords, RPC access tokens, private keys, or MACI secrets.
# Keep the existing .env for Hardhat Local; use a separate Supabase project for this file.

# Network: RPC_URL is server-only. MACI_RPC_URL must be the exact same URL.
# Use an HTTPS endpoint that returns eth_chainId = 0x61 (97), never mainnet 0x38 (56).
# NEXT_PUBLIC_MACI_RPC_URL is bundled into the static web build: use a public,
# browser-accessible HTTPS endpoint with no secret token, username, or query string.
CHAIN_ID=97
RPC_URL=https://<server-bsc-testnet-rpc>
MACI_RPC_URL=https://<server-bsc-testnet-rpc>
NEXT_PUBLIC_MACI_RPC_URL=https://<public-browser-bsc-testnet-rpc>
CHAIN_CONFIRMATIONS=2
# Maximum offered gas price: 1 gwei. Worst-case deployment journal exposure:
# 0.1 tBNB. The candidate anchor has a separate fixed 0.001 tBNB ceiling.
MACI_DEPLOYMENT_MAX_GAS_PRICE_WEI=1000000000
MACI_DEPLOYMENT_MAX_COST_WEI=100000000000000000

# Explicit transaction gate. Leave false while license, artifact, advisory,
# gas/bytecode, and proof compatibility reviews remain open. The API and worker
# reject chain-97 transactions when this is not true.
MACI_BSC_TESTNET_ENABLED=false

# Dedicated BSC Testnet Supabase project, private schema "voting".
# DATABASE_URL: limited runtime role, session pooler, verified TLS.
# MIGRATION_DATABASE_URL: migration role on direct/session connectivity; only
# migration commands use it. Never point either URL to the Hardhat project's DB.
# Percent-encode reserved characters in URL usernames/passwords.
DATABASE_URL="postgresql://<runtime-user>.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=verify-full"
MIGRATION_DATABASE_URL="postgresql://<migration-user>.<project-ref>:<url-encoded-password>@<direct-or-session-host>:5432/postgres?sslmode=verify-full"
DATABASE_POOL_MODE=session
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
# For the shared Supabase pooler, download the project CA from Database Settings
# and set its local path here. Add sslrootcert=<same-path> to the migration URL.
# Keep verification enabled; the file must exist on every runtime host.
DATABASE_CA_PATH=

# This example runs the web and API locally while using the real BSC Testnet.
# For remote HTTPS hosting, set both origins to their actual HTTPS addresses and
# configure API_HOST/reverse proxy accordingly. Rebuild web after NEXT_PUBLIC changes.
# scripts/web.mjs derives NEXT_PUBLIC_CHAIN_ID=97 from CHAIN_ID.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Publish the exact, reviewed web source revision before serving the demo.
# The URL is displayed to users and must end in /tree/<40-hex-commit>.
NEXT_PUBLIC_SOURCE_URL=https://github.com/<owner>/<public-source-repository>/tree/<40-hex-commit>
APP_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=3000

# Server-only EVM signers. Each value is 0x followed by exactly 64 hex digits.
# Use five independent limited-fund keys. Fund deployer and transaction
# sponsors with test BNB. Never use a mainnet key or NEXT_PUBLIC_*.
DEPLOYER_PRIVATE_KEY=0x<64-hex-deployer-key>
MACI_ISSUER_PRIVATE_KEY=0x<64-hex-issuer-key>
MACI_REGISTRATION_RELAYER_PRIVATE_KEY=0x<64-hex-registration-sponsor-key>
MACI_JOIN_RELAYER_PRIVATE_KEY=0x<64-hex-join-sponsor-key>
MACI_RELAYER_PRIVATE_KEY=0x<64-hex-message-sponsor-key>

# Serialized public key from MACI v3 PublicKey.serialize() for a fresh,
# independent coordinator keypair. Do not type or derive this value manually.
# Run node scripts/generate-maci-coordinator-testnet.mjs after creating both
# ignored .env files; the command writes the matching private key to the worker.
# The matching private key belongs only in the separate proof-worker environment.
MACI_COORDINATOR_PUBLIC_KEY=macipk.<serialized-public-key>

# Transaction limits are integer gas units and integer wei, never floating point.
# Re-evaluate these caps against measured chain-97 estimates before enabling writes.
MACI_REGISTRATION_MAX_GAS=500000
MACI_JOIN_MAX_GAS=1000000
MACI_RELAYER_MAX_GAS=500000
MACI_RELAYER_MAX_GAS_PRICE_WEI=10000000000

# Hardhat-only automining and synthetic admin seeding must stay disabled on BSC.
MACI_PROOF_LOCAL_AUTOMINE=false
MACI_SYNTHETIC_ADMIN_ENABLED=false

# Create a separate ignored .env.bsc-worker for the proof worker. It must repeat
# CHAIN_ID, RPC_URL, MACI_RPC_URL, CHAIN_CONFIRMATIONS, MACI_BSC_TESTNET_ENABLED,
# DATABASE_URL and its pool/TLS options from this file, then add only:
# MACI_PROVER_PRIVATE_KEY=0x<64-hex-independent-funded-prover-key>
# MACI_COORDINATOR_PRIVATE_KEY=macisk.<64-hex-independent-coordinator-secret>
# Do not supply these worker secrets to the API, deployer or web build.
